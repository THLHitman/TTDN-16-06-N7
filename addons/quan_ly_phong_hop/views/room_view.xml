<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_room_meeting_tree" model="ir.ui.view">
        <field name="name">room.meeting.tree</field>
        <field name="model">room.meeting</field>
        <field name="arch" type="xml">
            <tree string="Danh sách phòng họp">
                <field name="ma_phong_hop"/>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_room_meeting_form" model="ir.ui.view">
        <field name="name">room.meeting.form</field>
        <field name="model">room.meeting</field>
        <field name="arch" type="xml">
            <form string="Thông tin phòng họp">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" string="Tên phòng họp"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Phòng họp Lotus"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="ma_phong_hop" />
                            <field name="location" placeholder="Ví dụ: Tầng 2, Khu A"/>
                        </group>
                        <group> 
                            <field name="note" string="Ghi chú về phòng họp"/>
                        </group>
                        
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_room_meeting_search" model="ir.ui.view">
        <field name="name">room.meeting.search</field>
        <field name="model">room.meeting</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm phòng họp">
                <field name="name" string="Tên phòng"/>
                <field name="ma_phong_hop" string="Mã phòng"/>
                <field name="location" string="Vị trí"/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Vị trí" name="group_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_room_meeting_kanban" model="ir.ui.view">
        <field name="name">room.meeting.kanban</field>
        <field name="model">room.meeting</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="ma_phong_hop"/>
                <field name="location"/>
                <field name="capacity"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="ma_phong_hop" widget="badge"/>
                                <br/>
                                <i class="fa fa-map-marker"/> <field name="location"/>
                                <br/>
                                <i class="fa fa-users"/> Sức chứa: <field name="capacity"/> người
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_room_meeting" model="ir.actions.act_window">
        <field name="name">Phòng họp</field>
        <field name="res_model">room.meeting</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có phòng họp nào!
            </p>
            <p>
                Nhấn nút <b>Tạo</b> để thêm phòng họp mới.<br/>
                Sau đó bạn có thể phân bổ tài sản vào từng phòng họp.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_room_root" 
              name="Quản lý Phòng họp" 
              sequence="10"/>

    <menuitem id="menu_room_config" 
              name="Phòng họp" 
              parent="menu_room_root" 
              action="action_room_meeting" 
              sequence="10"/>
</odoo>