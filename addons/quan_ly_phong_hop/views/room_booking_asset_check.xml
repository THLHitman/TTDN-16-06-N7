<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_room_booking_asset_check_tree" model="ir.ui.view">
        <field name="name">room.booking.asset.check.tree</field>
        <field name="model">room.booking.asset.check</field>
        <field name="arch" type="xml">
            <tree string="Kiểm tra tài sản phòng họp">
                <field name="booking_id"/>
                <!-- <field name="tai_san_id"/> -->
                <field name="check_type"/>
                <field name="state"/>
                <field name="check_time"/>
            </tree>
        </field>
    </record>

    <record id="view_room_booking_asset_check_form" model="ir.ui.view">
        <field name="name">room.booking.asset.check.form</field>
        <field name="model">room.booking.asset.check</field>
        <field name="arch" type="xml">
            <form string="Kiểm tra tài sản">
                <sheet>
                    <group>
                        <field name="booking_id" readonly="1"/>
                        <!-- <field name="phan_bo_tai_san_id" readonly="1"/> -->
                        <!-- <field name="tai_san_id" readonly="1"/> -->
                    </group>

                    <group>
                        <field name="check_type" readonly="1"/>
                        <field name="state"/>
                        <field name="check_time" readonly="1"/>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>




