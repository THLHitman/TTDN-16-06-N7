<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree view -->
        <record id="view_phong_hop_tree" model="ir.ui.view">
            <field name="name">phong.hop.tree</field>
            <field name="model">phong_hop</field>
            <field name="arch" type="xml">
                <tree string="Danh sách phòng họp">
                    <field name="ma_phong_hop"/>
                    <field name="ten_phong_hop"/>
                    <field name="suc_chua"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_phong_hop_form" model="ir.ui.view">
            <field name="name">phong.hop.form</field>
            <field name="model">phong_hop</field>
            <field name="arch" type="xml">
                <form string="Thông tin phòng họp">
                    <sheet>
                        <group>
                            <group>
                                <field name="ma_phong_hop"/>
                                <field name="ten_phong_hop"/>
                                <field name="suc_chua"/>
                                <field name="trang_thai"/>
                            </group>
                        </group>

                        <group string="Thiết bị">
                            <field name="thiet_bi"/>
                        </group>

                        <group string="Ghi chú">
                            <field name="ghi_chu"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_phong_hop" model="ir.actions.act_window">
            <field name="name">Quản lý phòng họp</field>
            <field name="res_model">phong_hop</field>
            <field name="view_mode">tree,form</field>
        </record>


    </data>
</odoo>