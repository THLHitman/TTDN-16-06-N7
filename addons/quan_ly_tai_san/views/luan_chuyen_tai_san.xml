<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_luan_chuyen_tai_san_form" model="ir.ui.view">
            <field name="name">luan_chuyen_tai_san.view.form</field>
            <field name="model">luan_chuyen_tai_san</field>
            <field name="arch" type="xml">
                <form string="Luân chuyển tài sản">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="ma_phieu_luan_chuyen" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Thông tin nguồn (Từ đâu)">
                                <field name="loai_nguon" widget="radio" options="{'horizontal': true}"/>
                                <field name="bo_phan_nguon" 
                                    attrs="{'invisible': [('loai_nguon', '!=', 'phong_ban')], 'required': [('loai_nguon', '=', 'phong_ban')]}"/>
                                <field name="phong_hop_nguon" 
                                    attrs="{'invisible': [('loai_nguon', '!=', 'phong_hop')], 'required': [('loai_nguon', '=', 'phong_hop')]}"/>
                            </group>
                            
                            <group string="Thông tin đích (Đến đâu)">
                                <field name="loai_dich" widget="radio" options="{'horizontal': true}"/>
                                <field name="bo_phan_dich" 
                                    attrs="{'invisible': [('loai_dich', '!=', 'phong_ban')], 'required': [('loai_dich', '=', 'phong_ban')]}"/>
                                <field name="phong_hop_dich" 
                                    attrs="{'invisible': [('loai_dich', '!=', 'phong_hop')], 'required': [('loai_dich', '=', 'phong_hop')]}"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="thoi_gian_luan_chuyen"/>
                            <field name="ghi_chu"/>
                        </group>

                        <notebook>
                            <page name="tai_san_luanchuyen" string="Tài sản luân chuyển">
                                <field name="luan_chuyen_line_ids">
                                    <tree editable="bottom" string="Chi tiết tài sản">
                                        <field name="phan_bo_tai_san_id"
                                            column_invisible="1"
                                            domain="[
                                                ('trang_thai', '=', 'in-use'),
                                                ('active', '=', True),
                                                ('phong_ban_id', '=', parent.bo_phan_nguon),
                                                ('room_id', '=', parent.phong_hop_nguon)
                                            ]"
                                            options="{'no_create': True, 'no_open': True}"
                                            string="Tài sản"/>
                                        <field name="so_luong"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_luan_chuyen_tai_san_tree" model="ir.ui.view">
            <field name="name">luan_chuyen_tai_san.view.tree</field>
            <field name="model">luan_chuyen_tai_san</field>
            <field name="arch" type="xml">
                <tree string="Danh sách luân chuyển tài sản">
                    <field name="ma_phieu_luan_chuyen"/>
                    <field name="bo_phan_nguon" optional="show"/>
                    <field name="phong_hop_nguon" optional="hide"/>
                    <field name="bo_phan_dich" optional="show"/>
                    <field name="phong_hop_dich" optional="hide"/>
                    <field name="thoi_gian_luan_chuyen"/>
                    <field name="ghi_chu"/>
                </tree>
            </field>
        </record>

        <record id="view_luan_chuyen_tai_san_search" model="ir.ui.view">
            <field name="name">luan_chuyen_tai_san.view.search</field>
            <field name="model">luan_chuyen_tai_san</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm luân chuyển tài sản">
                    <field name="ma_phieu_luan_chuyen"/>
                    <field name="bo_phan_nguon"/>
                    <field name="phong_hop_nguon"/>
                    <field name="bo_phan_dich"/>
                    <field name="thoi_gian_luan_chuyen"/>
                    <field name="ghi_chu"/>
                    
                    <filter string="Hôm nay" name="today"
                            domain="[('thoi_gian_luan_chuyen', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                     ('thoi_gian_luan_chuyen', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="0" string="Nhóm theo">
                        <filter string="Bộ phận nguồn" name="group_bo_phan_nguon"
                                context="{'group_by': 'bo_phan_nguon'}"/>
                         <filter string="Phòng họp nguồn" name="group_phong_hop_nguon"
                                context="{'group_by': 'phong_hop_nguon'}"/>
                        <filter string="Bộ phận đích" name="group_bo_phan_dich"
                                context="{'group_by': 'bo_phan_dich'}"/>
                        <filter string="Ngày luân chuyển" name="group_date"
                                context="{'group_by': 'thoi_gian_luan_chuyen'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="luan_chuyen_tai_san_action" model="ir.actions.act_window">
            <field name="name">Luân chuyển tài sản</field>
            <field name="res_model">luan_chuyen_tai_san</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>